{
  "name": "donut-mcp-server",
  "version": "0.1.0",
  "description": "A Model Context Protocol server for donut",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "syncpack fix",
    "bundle": "pnpm exec esbuild src/index.ts --bundle --platform=node --outfile=./dist/mcp-server.bundle.mjs --format=esm --external:@modelcontextprotocol/sdk --external:express --external:express-rate-limit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format": "biome check --write src/"
  },
  "dependencies": {
    "donut-api": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "26.4.0",
    "donut-test-fixtures": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "^4.5.2"
  }
}
