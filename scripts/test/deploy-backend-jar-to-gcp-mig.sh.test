#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
DEPLOY_SCRIPT="$REPO_ROOT/infra/gcp/scripts/deploy-backend-jar-to-gcp-mig.sh"
REAL_BASH="$(command -v bash)"
TEST_GIT_SHA=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# shellcheck source=deploy-backend-jar-to-gcp-mig-test-lib.sh
source "$REPO_ROOT/scripts/test/deploy-backend-jar-to-gcp-mig-test-lib.sh"

cleanup_work_dir() {
	if [[ -n "${work_dir:-}" ]]; then
		rm -rf -- "$work_dir"
		work_dir=""
	fi
}

trap cleanup_work_dir EXIT

setup_deploy_test() {
	work_dir=$(mktemp -d)
	fake_bin_dir="$work_dir/fakebin"
	write_fake_bin "$fake_bin_dir"
	write_fail_closed_fakes "$fake_bin_dir"
	init_deploy_test_logs "$work_dir"
	export GCS_BUCKET=bucket ARTIFACT=a VERSION=1 GITHUB_SHA="$TEST_GIT_SHA"
	export MAINTENANCE_STOP_GRACE_SECONDS=0
	unset DEPLOY_JAR_PATH FORCE_FULL_DEPLOY RECORD_JSON_FILE
}

run_test() {
	setup_deploy_test
	"$@"
	cleanup_work_dir
}

write_fail_closed_fakes() {
	local fake_bin=$1
	{
		printf '#!%s\n' "$REAL_BASH"
		printf 'REAL_BASH_PATH=%q\n' "$REAL_BASH"
		cat <<'EOS'
set -e
case "$*" in
*deploy-backend-jar-to-gcp-mig.sh*)
	exec "$REAL_BASH_PATH" "$@"
	;;
*apply-doughnut-app-service-url-map.sh*)
	exec "$REAL_BASH_PATH" "$@"
	;;
*enter-maintenance-mode.sh*)
	echo "enter-maintenance-mode $*" >>"${ROLLING_LOG:?}"
	echo "enter-maintenance-mode" >>"${STEPS_LOG:?}"
	exec "$REAL_BASH_PATH" "$@"
	;;
*create-mig-instance-template-for-maintenance.sh*)
	echo "create-mig-instance-template-for-maintenance $*" >>"${ROLLING_LOG:?}"
	exit 0
	;;
*exit-maintenance-mode.sh*)
	echo "exit-maintenance-mode $*" >>"${ROLLING_LOG:?}"
	exit 0
	;;
*check-mig-rollout.sh*)
	echo "check-mig-rollout $*" >>"${ROLLOUT_LOG:?}"
	exit 0
	;;
*app-instance-healthcheck.sh*)
	echo "app-instance-healthcheck $*" >>"${HEALTHCHECK_LOG:?}"
	exit 0
	;;
*)
	echo "unexpected bash command: $*" >&2
	exit 1
	;;
esac
EOS
	} >"$fake_bin/bash"
	chmod +x "$fake_bin/bash"

	{
		printf '#!%s\n' "$REAL_BASH"
		cat <<'EOS'
set -e
echo "$*" >>"${GCLOUD_LOG:?}"
case "$*" in
"compute url-maps import doughnut-app-service-map --source="*" --global --quiet")
	exit 0
	;;
"compute url-maps invalidate-cdn-cache doughnut-app-service-map --path /* --global --async")
	exit 0
	;;
"compute instance-groups managed describe doughnut-app-group --zone=us-east1-b --format=value(targetSize)")
	echo 1
	exit 0
	;;
"compute instance-groups managed update doughnut-app-group --update-policy-type=OPPORTUNISTIC --zone=us-east1-b")
	exit 0
	;;
"compute instance-groups managed resize doughnut-app-group --size=0 --zone=us-east1-b")
	exit 0
	;;
"compute instance-groups managed list-instances doughnut-app-group --zone=us-east1-b --format=value(instance)")
	exit 0
	;;
*)
	echo "unexpected gcloud: $*" >&2
	exit 1
	;;
esac
EOS
	} >"$fake_bin/gcloud"
	chmod +x "$fake_bin/gcloud"
}

assert_mig_closed_in_order() {
	local log=$1
	awk '
		/compute instance-groups managed describe / { describe=NR }
		/compute instance-groups managed update / && /--update-policy-type=OPPORTUNISTIC/ { update=NR }
		/compute instance-groups managed resize / && /--size=0/ { resize=NR }
		/compute instance-groups managed list-instances / { list=NR }
		END {
			if (!describe || !update || !resize || !list ||
				describe >= update || update >= resize || resize >= list) exit 1
		}
	' "$log" || fail "MIG closure commands missing or out of order"
}

assert_fail_closed_release() {
	grep -q 'enter-maintenance-mode.sh' "$ROLLING_LOG" || fail "maintenance entry not invoked"
	assert_mig_closed_in_order "$GCLOUD_LOG"
	! grep -qE 'create-mig-instance-template|exit-maintenance-mode' "$ROLLING_LOG" || fail "template/reopen invoked"
	! grep -q 'set-instance-template' "$GCLOUD_LOG" || fail "template assignment invoked"
	assert_healthcheck_not_invoked "$HEALTHCHECK_LOG"
	assert_rollout_not_invoked "$ROLLOUT_LOG"
	grep -q 'cp .*backend_app_jar' "$GSUTIL_LOG" || fail "jar upload not logged"
	! grep -q 'cp - gs://' "$GSUTIL_LOG" || fail "success record written"
	grep -q 'Release stopped safely with the MIG closed' "$work_dir/stderr" || fail "safe stop not reported"
}

test_fails_when_jar_missing() {
	if run_deploy "$work_dir" "$fake_bin_dir" 2>/dev/null; then fail "expected missing jar failure"; fi
}

test_matching_release_skips_jar_deploy() {
	local jar="$work_dir/a-1.jar"
	printf '%s' fixture >"$jar"
	write_matching_deploy_record "$work_dir/record.json" "$jar"
	RECORD_JSON_FILE="$work_dir/record.json" DEPLOY_JAR_PATH="$jar" run_deploy "$work_dir" "$fake_bin_dir"
	grep -q 'compute url-maps import' "$GCLOUD_LOG" || fail "URL map import not invoked when jar deploy skipped"
	assert_not_file_exists "$ROLLING_LOG"
	assert_healthcheck_not_invoked "$HEALTHCHECK_LOG"
	assert_rollout_not_invoked "$ROLLOUT_LOG"
	local cp_count cat_count
	cp_count=$(grep -c '^cp ' "$GSUTIL_LOG" 2>/dev/null || true)
	cat_count=$(grep -c '^cat ' "$GSUTIL_LOG" 2>/dev/null || true)
	assert_equals "0" "$cp_count" "no gsutil cp when skipped"
	assert_equals "1" "$cat_count" "one gsutil cat when skipped"
}

test_new_release_closes_then_fails_safely() {
	local jar="$work_dir/a-1.jar"
	printf '%s' changed >"$jar"
	if DEPLOY_JAR_PATH="$jar" run_deploy "$work_dir" "$fake_bin_dir" 2>"$work_dir/stderr"; then
		fail "expected safe interim stop"
	fi
	assert_fail_closed_release
}

test_jar_hash_change_closes_then_fails_safely() {
	local jar="$work_dir/a-1.jar"
	printf '%s' changed >"$jar"
	write_matching_deploy_record "$work_dir/record.json" "$jar"
	printf '%s' newer >"$jar"
	if RECORD_JSON_FILE="$work_dir/record.json" DEPLOY_JAR_PATH="$jar" \
		run_deploy "$work_dir" "$fake_bin_dir" 2>"$work_dir/stderr"; then
		fail "expected changed jar safe stop"
	fi
	assert_fail_closed_release
}

test_startup_script_hash_change_closes_then_fails_safely() {
	local jar="$work_dir/a-1.jar"
	printf '%s' fixture >"$jar"
	local jar_hash
	jar_hash=$(sha256sum "$jar" | awk '{print $1}')
	printf '{"sha256":"%s","startup_script_sha256":"changed"}\n' "$jar_hash" >"$work_dir/startup-changed-record.json"
	if RECORD_JSON_FILE="$work_dir/startup-changed-record.json" DEPLOY_JAR_PATH="$jar" \
		run_deploy "$work_dir" "$fake_bin_dir" 2>"$work_dir/stderr"; then
		fail "expected changed startup script safe stop"
	fi
	assert_fail_closed_release
}

test_forced_release_closes_then_fails_safely() {
	local jar="$work_dir/a-1.jar"
	printf '%s' fixture >"$jar"
	write_matching_deploy_record "$work_dir/record.json" "$jar"
	if RECORD_JSON_FILE="$work_dir/record.json" DEPLOY_JAR_PATH="$jar" FORCE_FULL_DEPLOY=1 \
		run_deploy "$work_dir" "$fake_bin_dir" 2>"$work_dir/stderr"; then
		fail "expected forced release safe stop"
	fi
	assert_fail_closed_release
}

run_test test_fails_when_jar_missing
run_test test_matching_release_skips_jar_deploy
run_test test_new_release_closes_then_fails_safely
run_test test_jar_hash_change_closes_then_fails_safely
run_test test_startup_script_hash_change_closes_then_fails_safely
run_test test_forced_release_closes_then_fails_safely
echo "ok deploy-backend-jar-to-gcp-mig.sh tests"
