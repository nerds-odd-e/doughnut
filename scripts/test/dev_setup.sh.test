#!/usr/bin/env bash
#
# Tests for scripts/dev_setup.sh Biome daemon helpers using Bach testing framework

# Captured before Bach rewrites PATH so the real-execution test below can spawn a
# clean bash that sources the real dev_setup.sh (see start_detached test).
DONUT_TEST_REAL_PATH="$PATH"
DONUT_TEST_REAL_BASH="$(command -v bash)"
DONUT_TEST_REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
DONUT_TEST_DEV_SETUP_SH="${DONUT_TEST_REPO_ROOT}/scripts/dev_setup.sh"

source "$(dirname "$0")/vendor/bach.sh"

# Stand-in for the external pnpm binary, shared by the real-invocation probes
# below: records every invocation and, after a frozen-lockfile install, leaves
# the completed-install marker and each workspace project's node_modules like
# real pnpm would, without touching the network or the real package graph.
# DONUT_TEST_PNPM_FAIL makes the install fail with pnpm's lockfile message.
write_fake_pnpm_stub() {
    local bin="$1"
    @mkdir -p "${bin}"
    @cat >"${bin}/pnpm" <<'FAKE_PNPM'
#!/usr/bin/env bash
echo "$*" >>"${DONUT_TEST_PNPM_LOG}"
if [ -n "${DONUT_TEST_PNPM_FAIL:-}" ]; then
    echo "ERR_PNPM_OUTDATED_LOCKFILE  Cannot install with \"frozen-lockfile\" because pnpm-lock.yaml is not up to date with app/package.json" >&2
    exit 1
fi
if [ "$1" = "--frozen-lockfile" ]; then
    mkdir -p node_modules
    : >node_modules/.modules.yaml
    for project in $(awk '/^ *- / { print $2 }' pnpm-workspace.yaml); do
        mkdir -p "${project}/node_modules"
    done
fi
FAKE_PNPM
    @chmod +x "${bin}/pnpm"
}

# Real command-boundary proof of setup_pnpm_deps: a clean bash sources the real
# dev_setup.sh in a disposable workspace (real pnpm-lock.yaml, package.json and
# pnpm-workspace.yaml listing one project, `app`, that declares dependencies),
# with only the external pnpm substituted. Runs the probe body given on stdin
# and prints its output.
run-dependency-probe() {
    local work bin probe
    work="$(@mktemp -d)"
    bin="${work}/bin"
    probe="${work}/probe.sh"
    write_fake_pnpm_stub "${bin}"
    @cat >"${probe}" <<'PROBE'
set -euo pipefail
export PATH="$1:$2"
repo_root="$3"
work="$4"
export DONUT_TEST_PNPM_LOG="$5"

cd "${work}"
: >pnpm-lock.yaml
: >package.json
printf 'packages:\n  - app\n' >pnpm-workspace.yaml
mkdir -p app
printf '{ "dependencies": {} }\n' >app/package.json
: >"${DONUT_TEST_PNPM_LOG}"

source "${repo_root}/scripts/shell_setup.sh"
source "${repo_root}/scripts/dev_setup.sh"
setup_logging >/dev/null
PROBE
    @cat >>"${probe}"
    @real env -i "PATH=${DONUT_TEST_REAL_PATH}" \
        "${DONUT_TEST_REAL_BASH}" "${probe}" \
        "${bin}" "${DONUT_TEST_REAL_PATH}" "${DONUT_TEST_REPO_ROOT}" "${work}" "${work}/pnpm-calls.log" 2>&1
}

# Installs once, records the fingerprint, skips the repeat, and never touches
# the Biome daemon (unlike setup_pnpm_and_biome).
test-setup-pnpm-deps-real-invocation-installs-once-then-skips-and-skips-biome() {
    local result
    result="$(run-dependency-probe <<'PROBE'
setup_pnpm_deps >/dev/null
fingerprint="$([ -f .donut-pnpm-lock.sha256 ] && echo yes || echo no)"
setup_pnpm_deps >/dev/null
echo "calls=$(wc -l <"${DONUT_TEST_PNPM_LOG}" | tr -d ' ') fingerprint=${fingerprint} biome_touched=$(grep -q biome "${DONUT_TEST_PNPM_LOG}" && echo yes || echo no)"
PROBE
)"
    @assert-equals "calls=1 fingerprint=yes biome_touched=no" "${result}"
}

# An install killed after linking but before the fingerprint was written is not
# trusted: the fingerprint is only recorded after a completed install.
test-setup-pnpm-deps-interrupted-install-missing-fingerprint-triggers-reinstall() {
    local result
    result="$(run-dependency-probe <<'PROBE'
mkdir -p node_modules app/node_modules
: >node_modules/.modules.yaml
setup_pnpm_deps >/dev/null
echo "calls=$(wc -l <"${DONUT_TEST_PNPM_LOG}" | tr -d ' ') fingerprint=$([ -f .donut-pnpm-lock.sha256 ] && echo yes || echo no)"
PROBE
)"
    @assert-equals "calls=1 fingerprint=yes" "${result}"
}

# A fingerprint recorded from different dependency inputs triggers a reinstall
# and is corrected to the current inputs.
test-setup-pnpm-deps-stale-fingerprint-triggers-reinstall() {
    local result
    result="$(run-dependency-probe <<'PROBE'
mkdir -p node_modules app/node_modules
: >node_modules/.modules.yaml
echo "stale-fingerprint-from-a-different-lockfile-state" >.donut-pnpm-lock.sha256
setup_pnpm_deps >/dev/null
echo "calls=$(wc -l <"${DONUT_TEST_PNPM_LOG}" | tr -d ' ') corrected=$([ "$(cat .donut-pnpm-lock.sha256)" = "$(donut_workspace_deps_fingerprint)" ] && echo yes || echo no)"
PROBE
)"
    @assert-equals "calls=1 corrected=yes" "${result}"
}

# A workspace project's manifest is a dependency input even though the root
# manifest and lockfile are unchanged.
test-setup-pnpm-deps-changed-workspace-manifest-triggers-reinstall() {
    local result
    result="$(run-dependency-probe <<'PROBE'
setup_pnpm_deps >/dev/null
printf '{ "dependencies": { "left-pad": "1.0.0" } }\n' >app/package.json
setup_pnpm_deps >/dev/null
echo "installs=$(grep -c frozen-lockfile "${DONUT_TEST_PNPM_LOG}")"
PROBE
)"
    @assert-equals "installs=2" "${result}"
}

# A different pnpm (resolved to a different executable path, as a new Nix store
# version is) does not trust the installation made by the previous one.
test-setup-pnpm-deps-changed-pnpm-triggers-reinstall() {
    local result
    result="$(run-dependency-probe <<'PROBE'
setup_pnpm_deps >/dev/null
mkdir -p "${work}/other-pnpm"
cp "$1/pnpm" "${work}/other-pnpm/pnpm"
PATH="${work}/other-pnpm:${PATH}" setup_pnpm_deps >/dev/null
echo "installs=$(grep -c frozen-lockfile "${DONUT_TEST_PNPM_LOG}")"
PROBE
)"
    @assert-equals "installs=2" "${result}"
}

# A workspace project that declares dependencies but lost its node_modules is
# an incomplete installation, whatever the fingerprint says.
test-setup-pnpm-deps-missing-project-modules-triggers-reinstall() {
    local result
    result="$(run-dependency-probe <<'PROBE'
setup_pnpm_deps >/dev/null
rm -rf app/node_modules
setup_pnpm_deps >/dev/null
echo "installs=$(grep -c frozen-lockfile "${DONUT_TEST_PNPM_LOG}") app_modules=$([ -d app/node_modules ] && echo yes || echo no)"
PROBE
)"
    @assert-equals "installs=2 app_modules=yes" "${result}"
}

# A failed install propagates pnpm's own message and status and records no
# fingerprint, so the next run tries again.
test-setup-pnpm-deps-failed-install-is-visible-and-not-recorded() {
    local result
    result="$(run-dependency-probe <<'PROBE'
status=0
DONUT_TEST_PNPM_FAIL=1 setup_pnpm_deps >/dev/null || status=$?
echo "status=${status} fingerprint=$([ -f .donut-pnpm-lock.sha256 ] && echo yes || echo no)"
PROBE
)"
    @assert-equals $'ERR_PNPM_OUTDATED_LOCKFILE  Cannot install with "frozen-lockfile" because pnpm-lock.yaml is not up to date with app/package.json\nstatus=1 fingerprint=no' "${result}"
}

# start_detached must shield direnv from daemon FD inheritance (direnv/direnv#755):
# it closes FD 3 and redirects the command's stdio to the log. Run the real
# function in a clean bash subprocess and probe both guarantees at once:
#   - writing to FD 3 from the child leaves the FD-3 file empty (FD 3 was closed)
#   - the child's stdout lands in the log file (stdio was redirected)
test-start-detached-closes-fd3-and-redirects-stdio() {
    local work fd3 out probe
    work="$(@mktemp -d)"
    fd3="${work}/fd3.txt"
    out="${work}/out.log"
    probe="${work}/probe.sh"

    @cat >"${probe}" <<'PROBE'
export PATH="$1"
source "$2"
exec 3>"$3"
start_detached "$4" sh -c 'echo leaked 2>/dev/null >&3 || true; echo redirected'
PROBE

    # env -i clears Bach's exported mock functions so the child bash sources the
    # real dev_setup.sh instead of Bach's `source` stub.
    @real env -i "PATH=${DONUT_TEST_REAL_PATH}" \
        "${DONUT_TEST_REAL_BASH}" "${probe}" \
        "${DONUT_TEST_REAL_PATH}" "${DONUT_TEST_DEV_SETUP_SH}" "${fd3}" "${out}" \
        >/dev/null 2>&1

    @assert-equals "fd3=[] out=[redirected]" "fd3=[$(@cat "${fd3}")] out=[$(@cat "${out}")]"
}

# Simulates stop_biome_daemon when no @biomejs server is running.
test-stop-biome-daemon-when-no-server() {
  pgrep -f '@biomejs.*biome __run_server' >/dev/null 2>&1 || true
}
test-stop-biome-daemon-when-no-server-assert() {
  pgrep -f '@biomejs.*biome __run_server'
}

# Simulates stop_biome_daemon when a server is running.
test-stop-biome-daemon-when-server-running() {
  pgrep -f '@biomejs.*biome __run_server'
  echo 'log: Stopping existing Biome daemon...'
  pkill -f '@biomejs.*biome __run_server'
}
test-stop-biome-daemon-when-server-running-assert() {
  pgrep -f '@biomejs.*biome __run_server'
  echo 'log: Stopping existing Biome daemon...'
  pkill -f '@biomejs.*biome __run_server'
}

# Simulates restart_biome_daemon after stop.
test-restart-biome-daemon() {
  pgrep -f '@biomejs.*biome __run_server'
  echo 'log: Starting Biome daemon...'
  pnpm biome start
}
test-restart-biome-daemon-assert() {
  pgrep -f '@biomejs.*biome __run_server'
  echo 'log: Starting Biome daemon...'
  pnpm biome start
}
