#!/usr/bin/env bash
#
# Tests for scripts/run.sh: invoke the real runner in a temporary repository,
# substituting only the external `nix` executable, which records its arguments.

DONUT_TEST_REAL_PATH="$PATH"
DONUT_TEST_REAL_BASH="$(command -v bash)"
DONUT_TEST_RUNNER="$(cd "$(dirname "$0")/.." && pwd)/run.sh"

source "$(dirname "$0")/vendor/bach.sh"

run-runner() {
  local scenario="$1"

  @real env -i \
    "PATH=${DONUT_TEST_REAL_PATH}" \
    "DONUT_TEST_RUNNER=${DONUT_TEST_RUNNER}" \
    "DONUT_TEST_SCENARIO=${scenario}" \
    "${DONUT_TEST_REAL_BASH}" <<'EOF'
set -euo pipefail

work="$(cd "$(mktemp -d)" && pwd -P)"
trap 'rm -rf "$work"' EXIT

repo="$work/repo"
mkdir -p "$repo/scripts" "$repo/sub dir" "$work/bin"
git -C "$repo" init -q
cp "$DONUT_TEST_RUNNER" "$repo/scripts/run.sh"
printf 'definition 1\n' >"$repo/flake.nix"
printf 'lock 1\n' >"$repo/flake.lock"

cat >"$work/bin/nix" <<'NIX'
#!/usr/bin/env bash
printf 'nix %s\n' "$*" | sed -e "s#$DONUT_TEST_WORK#WORK#g" >>"$DONUT_TEST_WORK/nix.log"
if [[ "$*" == *" --profile "* ]]; then
  [[ -z "${DONUT_TEST_POPULATE_FAIL:-}" ]] || { echo "error: undefined variable" >&2; exit 1; }
  ln -s "$DONUT_TEST_WORK/cached-env" "${@: -3:1}"
  exit 0
fi
while [[ "$1" != -c ]]; do shift; done
shift
exec "$@"
NIX
cat >"$work/child" <<'CHILD'
#!/usr/bin/env bash
printf '%s|%s|%s|%s|%s/%s/%s/%s/%s\n' "$PWD" "$1" "$2" "${CURSOR_DEV:-}" \
  "${DONUT_OFFLINE:-}" "${PIP_NO_INDEX:-}" "${npm_config_offline:-}" \
  "${pnpm_config_offline:-}" "${CYPRESS_INSTALL_BINARY:-}"
exit "$3"
CHILD
chmod +x "$work/bin/nix" "$work/child"
touch "$work/cached-env"
export DONUT_TEST_WORK="$work"

runner() {
  (cd "$repo/sub dir" && "$repo/scripts/run.sh" "$work/child" "a b" '*' "${DONUT_TEST_CHILD_EXIT:-0}") |
    sed -e "s#$work#WORK#g"
}

show_nix_log() {
  sed -E -e 's#donut-nix-env/[0-9a-f]{40}#donut-nix-env/KEY#g' "$work/nix.log"
  rm -f "$work/nix.log"
}

case "$DONUT_TEST_SCENARIO" in
  no-nix)
    PATH="/usr/bin:/bin" runner
    ;;
  inside-nix)
    PATH="$work/bin:$PATH" IN_NIX_SHELL=impure runner
    [[ ! -e "$work/nix.log" ]] && echo "nix not called"
    ;;
  cold-profile)
    export PATH="$work/bin:$PATH"
    runner 2>&1 || echo "status $?"
    [[ ! -e "$work/nix.log" ]] && echo "nix not called"
    ;;
  populate-then-reuse)
    export PATH="$work/bin:$PATH"
    DONUT_ALLOW_DOWNLOADS=1 runner
    show_nix_log
    runner
    show_nix_log
    printf 'snapshot: %s\n' "$(cat "$repo"/.git/donut-nix-env/*/flake/flake.nix)"
    printf 'snapshot files: %s\n' "$(ls -A "$repo"/.git/donut-nix-env/*/flake | tr '\n' ' ')"
    ;;
  linked-worktree)
    export PATH="$work/bin:$PATH"
    DONUT_ALLOW_DOWNLOADS=1 runner >/dev/null
    git -C "$repo" add scripts/run.sh flake.nix flake.lock
    git -C "$repo" -c user.name=Fixture -c user.email=fixture@example.invalid commit -qm fixture
    git -C "$repo" worktree add --detach -q "$work/linked"
    repo="$work/linked"
    mkdir "$repo/sub dir"
    runner
    ;;
  changed-definition)
    export PATH="$work/bin:$PATH"
    DONUT_ALLOW_DOWNLOADS=1 runner >/dev/null
    first="$(ls "$repo/.git/donut-nix-env")"
    rm -f "$work/nix.log"
    printf 'definition 2\n' >"$repo/flake.nix"
    DONUT_ALLOW_DOWNLOADS=1 runner >/dev/null
    show_nix_log | grep -c -- '--profile'
    second="$(ls "$repo/.git/donut-nix-env")"
    [[ "$first" != "$second" ]] && echo "only the new definition is kept: $(ls "$repo/.git/donut-nix-env" | wc -l | tr -d ' ')"
    ;;
  populate-failure)
    export PATH="$work/bin:$PATH"
    set +e
    DONUT_ALLOW_DOWNLOADS=1 DONUT_TEST_POPULATE_FAIL=1 runner 2>&1
    echo "status $?"
    set -e
    show_nix_log
    [[ ! -e "$repo"/.git/donut-nix-env/*/profile ]] && echo "no profile"
    ;;
  child-failure)
    export PATH="$work/bin:$PATH"
    DONUT_ALLOW_DOWNLOADS=1 runner >/dev/null
    set +e
    DONUT_TEST_CHILD_EXIT=7 runner >/dev/null
    echo "status $?"
    ;;
esac
EOF
}

test-runs-directly-without-nix() {
  @assert-equals 'WORK/repo/sub dir|a b|*||1/1/true/true/0' "$(run-runner no-nix)"
}

test-runs-directly-inside-nix() {
  @assert-equals $'WORK/repo/sub dir|a b|*||1/1/true/true/0\nnix not called' "$(run-runner inside-nix)"
}

test-cold-profile-stops-before-nix-without-opt-in() {
  @assert-equals "No cached Nix environment. On an unmetered connection, run DONUT_ALLOW_DOWNLOADS=1 ./scripts/run.sh bash scripts/worktree_setup.sh.
status 1
nix not called" "$(run-runner cold-profile)"
}

test-linked-worktree-uses-primary-profile-for-matching-flake() {
  @assert-equals 'WORK/linked/sub dir|a b|*|true|1/1/true/true/0' "$(run-runner linked-worktree)"
}

test-populates-recorded-environment-once-then-reuses-it() {
  @assert-equals "WORK/repo/sub dir|a b|*|true|////
nix develop path:WORK/repo/.git/donut-nix-env/KEY/flake --no-write-lock-file --profile WORK/repo/.git/donut-nix-env/KEY/profile -c true
nix develop WORK/repo/.git/donut-nix-env/KEY/profile --inputs-from path:WORK/repo/.git/donut-nix-env/KEY/flake --option flake-registry  -c WORK/child a b * 0
WORK/repo/sub dir|a b|*|true|1/1/true/true/0
nix develop --offline --option substitute false --max-jobs 0 --builders  WORK/repo/.git/donut-nix-env/KEY/profile --inputs-from path:WORK/repo/.git/donut-nix-env/KEY/flake --option flake-registry  -c WORK/child a b * 0
snapshot: definition 1
snapshot files: flake.lock flake.nix " "$(run-runner populate-then-reuse)"
}

test-changed-definition-builds-a-new-environment() {
  @assert-equals $'1\nonly the new definition is kept: 1' "$(run-runner changed-definition)"
}

test-populate-failure-is-visible-and-runs-nothing() {
  @assert-equals "error: undefined variable
status 1
nix develop path:WORK/repo/.git/donut-nix-env/KEY/flake --no-write-lock-file --profile WORK/repo/.git/donut-nix-env/KEY/profile -c true
no profile" "$(run-runner populate-failure)"
}

test-propagates-child-exit-status() {
  @assert-equals 'status 7' "$(run-runner child-failure)"
}
