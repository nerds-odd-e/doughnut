#!/usr/bin/env bash
#
# Unit tests for infra/gcp/scripts/app-instance-healthcheck.sh

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HEALTHCHECK_SCRIPT="$REPO_ROOT/infra/gcp/scripts/app-instance-healthcheck.sh"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

write_fake_curl() {
	local fake_bin=$1 response=$2
	mkdir -p "$fake_bin"
	{
		printf '#!%s\n' "$(command -v bash)"
		cat <<EOS
set -euo pipefail
output_file=""
write_code=0
url=""
while [[ \$# -gt 0 ]]; do
	case "\$1" in
	-o)
		output_file="\$2"
		shift 2
		;;
	-w)
		write_code=1
		shift 2
		;;
	-sk)
		shift
		;;
	*)
		url="\$1"
		shift
		;;
	esac
done
echo "curl \$url" >>"\${CURL_LOG:?}"
if [[ -n "\$output_file" ]]; then
	printf '%s' "$response" >"\$output_file"
else
	printf '%s' "$response"
fi
if [[ "\$write_code" == "1" ]]; then
	printf '%s' "\${CURL_HTTP_CODE:-200}"
fi
EOS
	} >"$fake_bin/curl"
	chmod +x "$fake_bin/curl"
}

test_succeeds_when_response_contains_ok() {
	local work fake_bin
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	fake_bin="$work/fakebin"
	write_fake_curl "$fake_bin" "OK"
	export CURL_LOG="$work/curl.log"
	: >"$CURL_LOG"
	export CURL_HTTP_CODE=200
	export HEALTHCHECK_URL="https://example.test/api/healthcheck"
	export HEALTHCHECK_RETRY_COUNT=1
	export HEALTHCHECK_RETRY_SLEEP_SECONDS=0
	PATH="$fake_bin:$PATH" bash "$HEALTHCHECK_SCRIPT"
	grep -q 'curl https://example.test/api/healthcheck' "$work/curl.log" || fail "expected curl against override URL"
	trap - EXIT
	rm -rf "$work"
}

test_fails_when_response_never_ok() {
	local work fake_bin output
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	fake_bin="$work/fakebin"
	write_fake_curl "$fake_bin" "503 no healthy upstream"
	export CURL_LOG="$work/curl.log"
	: >"$CURL_LOG"
	export CURL_HTTP_CODE=503
	export HEALTHCHECK_URL="https://bogus.example.test/api/healthcheck"
	export HEALTHCHECK_RETRY_COUNT=1
	export HEALTHCHECK_RETRY_SLEEP_SECONDS=0
	output=$(PATH="$fake_bin:$PATH" bash "$HEALTHCHECK_SCRIPT" 2>&1) && fail "expected non-zero exit when healthcheck never returns OK"
	printf '%s\n' "$output" | grep -q 'last status=503' || fail "failure message missing last status; got: $output"
	printf '%s\n' "$output" | grep -q 'body=503 no healthy upstream' || fail "failure message missing last body; got: $output"
	trap - EXIT
	rm -rf "$work"
}

main() {
	[[ -x "$HEALTHCHECK_SCRIPT" ]] || fail "healthcheck script not found or not executable: $HEALTHCHECK_SCRIPT"
	test_succeeds_when_response_contains_ok
	test_fails_when_response_never_ok
	echo "ok app-instance-healthcheck.sh tests"
}

main "$@"
