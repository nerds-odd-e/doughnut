#!/usr/bin/env bash
#
# Tests for scripts/worktree_setup.sh using the Bach testing framework.
#
# This is a real command-boundary proof, not a simulation: it creates a real
# disposable linked git worktree (via `git worktree add`), runs the real
# scripts/worktree_setup.sh against it in a clean subprocess (no Bach
# mocking), then asserts the generated .claude/skills/* symlinks actually
# exist in that worktree and resolve to real tracked skill directories
# inside it. setup_claude_skills itself is not mocked or faked.

# Captured before Bach rewrites PATH, so the real-execution probe below can
# spawn a clean bash unaffected by Bach's function mocking (same pattern as
# scripts/test/dev_setup.sh.test).
DONUT_TEST_REAL_PATH="$PATH"
DONUT_TEST_REAL_BASH="$(command -v bash)"
DONUT_TEST_REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
DONUT_TEST_WORKTREE_SETUP_SH="${DONUT_TEST_REPO_ROOT}/scripts/worktree_setup.sh"

source "$(dirname "$0")/vendor/bach.sh"

# Fresh worktree lacking generated .claude/skills/* -> real worktree_setup.sh
# -> tracked Claude discovery links exist in that worktree and resolve inside
# it (not into the source worktree's own .agents/skills). Running it twice
# proves it is safe to repeat.
test-worktree-setup-prepares-fresh-worktree() {
    local work probe
    work="$(@mktemp -d)"
    probe="${work}/probe.sh"

    @cat >"${probe}" <<'PROBE'
set -euo pipefail
export PATH="$1"
repo_root="$2"
setup_sh="$3"
work="$4"
branch="donut-test-worktree-setup-$$"
wt_path="${work}/fresh-worktree"

# Runs on every exit path (precondition failure, assertion failure, success)
# so the disposable linked worktree/branch never leaks.
cleanup() {
    git worktree remove --force "${wt_path}" >/dev/null 2>&1 || true
    git branch -D "${branch}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

cd "${repo_root}"
git worktree add -q -b "${branch}" "${wt_path}" HEAD >/dev/null 2>&1

# Absent before preparation: confirms the starting condition this slice fixes.
if [ -e "${wt_path}/.claude/skills" ]; then
    echo "PRECONDITION_FAILED: .claude/skills already present before setup"
    exit 1
fi

# scripts/worktree_setup.sh is this slice's uncommitted new artifact, so
# `git worktree add HEAD` (which checks out a committed ref, not the working
# tree) does not include it yet. Seed just that one new file so the fixture
# exercises today's uncommitted entry point; scripts/shell_setup.sh (the
# existing setup_claude_skills owner this entry point composes with) is
# already tracked and needs no seeding.
cp "${setup_sh}" "${wt_path}/scripts/worktree_setup.sh"
chmod +x "${wt_path}/scripts/worktree_setup.sh"

# Run the real entry point against the fresh worktree, from within it, twice
# (repeat safety), exactly as documented usage would.
(cd "${wt_path}" && bash "${wt_path}/scripts/worktree_setup.sh") >/dev/null
(cd "${wt_path}" && bash "${wt_path}/scripts/worktree_setup.sh") >/dev/null

wt_real="$(cd "${wt_path}" && pwd -P)"

count=0
for link in "${wt_path}"/.claude/skills/*/; do
    [ -L "${link%/}" ] || continue
    target="$(cd "${link}" && pwd -P)"
    case "${target}" in
        "${wt_real}"/.agents/skills/*) : ;;
        *)
            echo "BAD_TARGET:${link}->${target}"
            exit 1
            ;;
    esac
    [ -f "${link}SKILL.md" ] || {
        echo "MISSING_SKILL_MD:${link}"
        exit 1
    }
    count=$((count + 1))
done

if [ "${count}" -gt 0 ]; then
    echo "SYMLINKS_OK:${count}"
else
    echo "SYMLINKS_MISSING"
fi
PROBE

    local result
    result="$(@real env -i "PATH=${DONUT_TEST_REAL_PATH}" \
        "${DONUT_TEST_REAL_BASH}" "${probe}" \
        "${DONUT_TEST_REAL_PATH}" "${DONUT_TEST_REPO_ROOT}" \
        "${DONUT_TEST_WORKTREE_SETUP_SH}" "${work}")"

    @assert-equals true "$([[ "${result}" == SYMLINKS_OK:* ]] && echo true || echo "false (${result})")"
}
