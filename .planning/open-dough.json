{
  "skipProcessRetrospective": false,
  "intent": {
    "locations": [
      {
        "path": "e2e_test/features",
        "kind": "gherkin"
      },
      {
        "path": "frontend/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "runner": "vitest"
      },
      {
        "path": "backend/src/test/java",
        "kind": "java",
        "include": ["**/*Test.java"],
        "runner": "junit"
      },
      {
        "path": "scripts",
        "kind": "javascript",
        "include": ["**/*.test.mjs"],
        "runner": "node:test"
      },
      {
        "path": "infra",
        "kind": "javascript",
        "include": ["**/*.test.mjs"],
        "runner": "node:test"
      }
    ]
  }
}
