{
  "skipProcessRetrospective": false,
  "intent": {
    "locations": [
      {
        "path": "e2e_test/features",
        "kind": "gherkin",
        "proof": "e2e_test/proof",
        "proofGeneration": {
          "command": "RECORD_CUCUMBER_PROOF=1 CURSOR_DEV=true nix develop -c pnpm cy:run --spec e2e_test/features/note_creation_and_update/note_creation.feature"
        }
      },
      {
        "path": "frontend/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "runner": "vitest",
        "proof": "frontend/tests/proof",
        "proofGeneration": {
          "command": "RECORD_VITEST_PROOF=1 ./scripts/run.sh pnpm -C frontend test"
        }
      },
      {
        "path": "scripts",
        "kind": "javascript",
        "include": ["**/*.test.mjs"],
        "runner": "node:test",
        "proof": "scripts/proof",
        "proofGeneration": {
          "command": "RECORD_NODE_TEST_PROOF=1 NODE_OPTIONS='--test-reporter=spec --test-reporter-destination=stdout --test-reporter=./e2e_test/config/nodeTestProofReporter.mjs --test-reporter-destination=stdout' ./scripts/run.sh node --test scripts/log-utils.test.mjs"
        }
      },
      {
        "path": "infra",
        "kind": "javascript",
        "include": ["**/*.test.mjs"],
        "runner": "node:test",
        "proof": "infra/proof",
        "proofGeneration": {
          "command": "RECORD_NODE_TEST_PROOF=1 NODE_OPTIONS='--test-reporter=spec --test-reporter-destination=stdout --test-reporter=./e2e_test/config/nodeTestProofReporter.mjs --test-reporter-destination=stdout' ./scripts/run.sh node --test infra/gcp/path-routing/path-routing-validation.test.mjs"
        }
      }
    ]
  }
}
