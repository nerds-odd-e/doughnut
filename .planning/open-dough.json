{
  "intentCoverage": true,
  "ciWorkflow": "ci.yml",
  "skipProcessRetrospective": false,
  "intent": {
    "locations": [
      {
        "path": "e2e_test/features",
        "kind": "gherkin",
        "pageObjects": true
      },
      {
        "path": "frontend/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "makeMe": true
      },
      {
        "path": "cli/tests",
        "kind": "typescript",
        "include": ["**/*.test.ts", "**/*.test.tsx"],
        "makeMe": true
      },
      {
        "path": "backend/src/test/java",
        "sources": [{ "include": ["**/*Test.java"], "syntax": "java" }],
        "makeMe": true
      },
      {
        "path": "scripts",
        "label": "Scripts and Infrastructure",
        "sources": [
          { "include": ["test/*.test"], "syntax": "shell" },
          { "include": ["**/*.test.mjs"], "syntax": "javascript" }
        ]
      }
    ]
  }
}
