{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .agents/skills/execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .agents/skills/execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node .agents/skills/execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5,
        "loop_limit": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/strip-extra-trailing-newlines.mjs",
        "timeout": 5
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "node .cursor/hooks/strip-extra-trailing-newlines.mjs",
        "timeout": 5
      }
    ]
  }
}
